Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9967911Z pull() {
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9968136Z   local local_name="$1"
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9968393Z   shift
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9968696Z   if docker image inspect "$local_name" >/dev/null 2>&1; then
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9969107Z     echo "$local_name is already local"
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9969413Z     return 0
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9969632Z   fi
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9969853Z   local ref attempt delay
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9970123Z   for ref in "$@"; do
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9970371Z     attempt=1
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9970594Z     delay=2
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9970837Z     while [ "$attempt" -le 5 ]; do
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9971189Z       echo "pulling ${ref} (attempt ${attempt}/5)"
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9971546Z       if docker pull "$ref"; then
Test	Start Postgres, Redis and OpenBao	2026-10-03T03:52:20.9972132Z         if [ "$ref" != "$local_name" ]; then
