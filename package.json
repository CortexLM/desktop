{
  "name": "cortex-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Cortex desktop: Chat, Work, Bots, Files, Cortex Code and Space with a local agent engine.",
  "author": "Cortex Foundation / CortexLM",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CortexLM/desktop.git"
  },
  "type": "module",
  "main": "packages/desktop/dist/main.cjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:app && bun run build:desktop",
    "build:app": "cd packages/app && vite build",
    "build:desktop": "node packages/desktop/build.mjs",
    "dev:app": "cd packages/app && vite",
    "dev:api": "bun scripts/dev-api.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint packages scripts tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^8.0.6",
    "@base-ui/react": "1.8",
    "@cortex/client": "workspace:*",
    "@cortex/core": "workspace:*",
    "@cortex/i18n": "workspace:*",
    "@cortex/schema": "workspace:*",
    "@cortex/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.127",
    "electron": "44",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hono": "^4.13.12",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "19",
    "react-dom": "19",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "8",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
