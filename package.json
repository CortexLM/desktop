{
  "name": "cortex-ide",
  "version": "0.1.0",
  "private": true,
  "description": "IDE professionnel Electron avec orchestration d'agents IA multi-providers",
  "author": "Cortex IDE Team",
  "license": "MIT",
  "type": "module",
  "main": "packages/main/dist/index.js",
  "workspaces": [
    "packages/*"
  ],
  "//trustedDependencies": "better-sqlite3 ships a native addon. Bun skips postinstall scripts unless the package is trusted, which leaves no compiled binary — or a binary built for a different NODE_MODULE_VERSION. Vitest runs the suite under plain Node, so an unbuilt/stale addon fails every database test at `new Database()`. Keep this list in sync with any native dependency.",
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "scripts": {
    "dev": "bun run --filter main dev",
    "build": "bun run --filter \"*\" build",
    "build:main": "bun run --filter main build",
    "build:renderer": "bun run --filter renderer build",
    "build:preload": "bun run --filter preload build",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux",
    "release": "bun run build && electron-builder --publish always",
    "typecheck": "bun run --filter \"*\" typecheck",
    "lint": "bun run --filter \"*\" lint",
    "clean": "rm -rf packages/*/dist dist node_modules packages/*/node_modules",
    "test:e2e": "xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24' playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report test-results/html-report",
    "test:e2e:trace": "playwright show-trace",
    "//paper": "The Paper file `IDE New 01` owns the design. These commands pull from it; nothing under packages/tokens/src/*.generated.* or design/paper/ is hand-written. Needs PAPER_MCP_URL, PAPER_MCP_AUTH and PAPER_FILE_ID.",
    "paper:sync": "bun scripts/paper-sync.ts all",
    "paper:tokens": "bun scripts/paper-sync.ts tokens",
    "paper:manifest": "bun scripts/paper-sync.ts manifest",
    "paper:baselines": "bun scripts/paper-sync.ts baselines",
    "paper:spec": "bun scripts/paper-sync.ts spec",
    "paper:jsx": "bun scripts/paper-sync.ts jsx",
    "paper:icons": "bun scripts/paper-sync.ts icons",
    "build:native-dual-abi": "tsx scripts/build-native-dual-abi.ts",
    "verify:native-abi": "tsx scripts/verify-native-abi.ts",
    "screenshots:visual": "playwright test tests/visual/visual-regression.spec.ts",
    "screenshots:components": "playwright test tests/visual/component-isolation.spec.ts",
    "screenshots:storybook": "playwright test tests/visual/storybook-screenshots.spec.ts",
    "//test": "Vitest is the only unit-test runner. The root config delegates to every packages/*/vitest.config.ts plus tests/vitest.config.ts, so `test` runs the whole suite and `test:discovery` proves no file on disk was left unclaimed. Playwright owns tests/e2e, tests/visual and tests/accessibility via test:e2e.",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "//test:unit": "Negated rather than an explicit project list: a new package would silently drop out of an allowlist, which is the same silent-skip failure the discovery guard exists to prevent.",
    "test:unit": "vitest run --project '!root-tests'",
    "test:integration": "vitest run --project root-tests tests/integration",
    "test:performance": "vitest run --project root-tests tests/performance",
    "//test:performance:budgets": "The benches must run in the SAME invocation that scores them: check-budgets.ts reads tests/performance/results/, refuses files older than an hour, and fails when a budget has no measurement. Running the checker alone would score whatever is on disk. The results dir is cleared first so a deleted benchmark shows up as a missing metric instead of leaving its last good result behind.",
    "test:performance:budgets": "rm -rf tests/performance/results && bun run test:performance && bun tests/performance/check-budgets.ts --max-age-seconds=600",
    "test:visual-regression": "vitest run --project root-tests tests/visual-regression",
    "test:all": "bun run test:coverage && bun run test:e2e",
    "quality:duplication": "npx jscpd packages --format typescript --output quality-reports",
    "quality:circular": "npx madge --circular --extensions ts,tsx packages/",
    "test:discovery": "bun scripts/check-test-discovery.ts",
    "test:discovery:fast": "bun scripts/check-test-discovery.ts --fast"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cortex-ide/test-utils": "workspace:*",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@happy-dom/global-registrator": "18.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.13.0",
    "bun-types": "^1.3.14",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.1",
    "eslint-plugin-complexity": "^1.0.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.13",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-cron": "^4.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "zod": "^3.24.1"
  },
  "build": {
    "appId": "com.cortex.ide",
    "productName": "Cortex IDE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "packages/main/dist/**/*",
      "packages/renderer/dist/**/*",
      "packages/preload/dist/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/simple-git/**/*",
      "node_modules/node-cron/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraMetadata": {
      "main": "packages/main/dist/index.js"
    }
  }
}
