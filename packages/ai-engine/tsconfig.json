{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    // `node` for `process`, `bun-types` for the `bun:test` suites under
    // `src/**/__tests__`, `vitest/globals` for the vitest suites.
    "types": ["node", "bun-types", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
