{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    // The route-manifest suite reads design/paper/screens.json off disk, so this package
    // typechecks against Node's API surface as well as the DOM.
    "types": ["vitest/globals", "node"],
    // Sources use explicit .ts/.tsx specifiers, which is what Bun and Vite resolve
    // natively. Scoped here rather than in the base config because test-harness emits with
    // tsc and this flag requires noEmit.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.setup.ts", "vitest.config.ts", "vite.config.ts"]
}
