{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals"],
    // Sources use explicit .ts specifiers, which is what Bun and Vite resolve natively.
    // Scoped here rather than in the base config because test-harness emits with tsc and
    // this flag requires noEmit.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
