  "review§test": "@@ -0,0 +1,5 @@\n+test(\"returns page 2 without duplicates\", async () => {\n+  const a = await listInvoices({ orgId, page: 1, size: 20 });\n+  const b = await listInvoices({ orgId, page: 2, size: 20 });\n+  expect(ids(a)).not.toEqual(expect.arrayContaining(ids(b)));\n+});",
  "review§srcFile": "src/billing/invoices.ts",
  "review§testFile": "tests/billing/invoices.test.ts",
  "review§c1": "`q.page` comes from the query string. With `?page=abc`, `Math.max` returns `NaN` and Prisma gets `skip: NaN`: the query fails with a 500.",
