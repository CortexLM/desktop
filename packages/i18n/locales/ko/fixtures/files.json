    "src": "// Atelier Morel shop cart: totals, discounts and shipping.\nimport { round, type Item } from \"./price\";\n\nexport const FREE_SHIPPING_THRESHOLD = 80;\nconst SHIPPING_FEE = 6.9;\n\nexport type Line = { item: Item; quantity: number };\n\nexport function subtotal(lines: Line[]): number {\n  return lines.reduce((s, l) => s + l.item.price * l.quantity, 0);\n}\n\n// “Spring” discount: 10% from three ceramic pieces.\nexport function discount(lines: Line[]): number {\n  const pieces = lines.filter((l) => l.item.category === \"ceramics\");\n  const n = pieces.reduce((s, l) => s + l.quantity, 0);\n  return n >= 3 ? subtotal(pieces) * 0.1 : 0;\n}\n\nexport function shippingFee(total: number): number {\n  return total >= FREE_SHIPPING_THRESHOLD ? 0 : SHIPPING_FEE;\n}\n\nexport function total(lines: Line[]) {\n  const st = subtotal(lines);\n  const r = discount(lines);\n  const shipping = shippingFee(st - r);\n  return {\n    subtotal: round(st),\n    discount: round(r),\n    shipping,\n    total: round(st - r + shipping),\n  };\n}\n\nexport function addItem(lines: Line[], item: Item): Line[] {\n  const i = lines.findIndex((l) => l.item.id === item.id);\n  if (i === -1) return [...lines, { item, quantity: 1 }];\n  return lines.map((l, j) => (j === i ? { ...l, quantity: l.quantity + 1 } : l));\n}\n\nexport function removeItem(lines: Line[], id: string): Line[] {\n  return lines.filter((l) => l.item.id !== id);\n}",
