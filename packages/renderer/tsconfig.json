{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // No `rootDir`: the build is done by Vite (`vite build`), so this config is
    // typecheck-only (`tsc --noEmit`). `rootDir: "src"` only made tsc reject
    // the preload types imported by `src/global.d.ts` / `src/lib/api/client.ts`
    // and the shared test helpers under `<repo>/test/`.
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // `@testing-library/jest-dom/vitest` augments vitest's `Assertion` with the
    // jest-dom matchers (toBeInTheDocument, toHaveAttribute, ...). The runtime
    // side is already registered in vitest.setup.ts, but without this entry the
    // types were missing, so every such assertion was a TS2339 error under
    // `tsc --noEmit` — which is why type-level assertions in test files could
    // not be relied on as a gate.
    "types": [
      "vite/client",
      "node",
      "bun-types",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
