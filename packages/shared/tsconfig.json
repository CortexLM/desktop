{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // Tout le package vit sous `src/`, donc `rootDir` peut enfin l'être aussi.
    // Auparavant `rootDir` valait "." parce que `src/index.ts` réexportait
    // `../types` et `../schemas` : chaque fichier hors de `src` produisait un
    // TS6059, et l'arborescence émise dans `dist/` gagnait un niveau `src/`
    // parasite.
    "rootDir": "src",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
