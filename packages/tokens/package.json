{
  "name": "@cortex-ide/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "//generated": "tokens.generated.ts and tokens.generated.css are produced by `bun run paper:tokens` from the Paper file that owns the design. Edit the Paper tokens, not these files.",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.generated.css",
    "./semantic.css": "./src/semantic.css",
    "./layout.css": "./src/layout.css",
    "./layout": "./src/layout.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
