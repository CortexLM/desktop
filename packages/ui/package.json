{
  "name": "@cortex-ide/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "//design": "Every component here is a transcription of a section of the Paper UI kit. The reference JSX for each lives in design/paper/jsx/, and the geometry tests assert against it.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/components/*.tsx",
    "./theme": "./src/theme/index.ts",
    "./icons": "./src/icons/index.tsx",
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@cortex-ide/tokens": "workspace:*",
    "@kobalte/core": "^0.13.11",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^28.1.0",
    "vite": "^6.3.6",
    "vite-plugin-solid": "^2.11.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
